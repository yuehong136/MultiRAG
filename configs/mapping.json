{
  "mappings": {
    "dynamic_templates": [
      {
        "standard_vector_template": {
          "match": "vector",
          "mapping": {
            "type": "FLOAT_VECTOR",
            "dims": 768,
            "similarity": "COSINE"
          }
        }
      },
      {
        "dynamic_vector_template": {
          "match_pattern": "regex",
          "match": "q_[0-9]+_vec",
          "mapping": {
            "type": "FLOAT_VECTOR",
            "dims": "auto",
            "similarity": "COSINE"
          }
        }
      },
      {
        "primary_key_template": {
          "match": "pk",
          "mapping": {
            "type": "VARCHAR",
            "max_length": 512,
            "is_primary": true
          }
        }
      },
      {
        "doc_id_template": {
          "match": "doc_id",
          "mapping": {
            "type": "VARCHAR",
            "max_length": 128
          }
        }
      },
