# Install as /etc/multirag/channel-supervisor.env with mode 0600.
# This file belongs only to the supervisor service. Do not put the Channel
# encryption key, Feishu App Secret, or a demo Agent token here.
MULTIRAG_CHANNELS__CONTROL__RUNTIME_API_BASE_URL=https://multirag.example.com
MULTIRAG_CHANNELS__CONTROL__INTERNAL_API_TOKEN=<same-master-workload-token-as-api>

# Optional tuning:
# MULTIRAG_CHANNELS__CONTROL__RECONCILE_INTERVAL_SECONDS=10
# MULTIRAG_CHANNELS__CONTROL__RUNTIME_HEARTBEAT_SECONDS=15
