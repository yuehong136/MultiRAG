# Optional overrides for docker-compose-standalone.yml. The compose file also
# works without this file; copy it to .env when you want persistent settings.

MULTIRAG_IMAGE=datav/multirag:latest
MULTIRAG_MODEL_DIR=/data/multirag/models
MULTIRAG_CONFIG_FILE=/data/multirag/service_conf.yaml

MULTIRAG_HTTP_PORT=80
MULTIRAG_API_PORT=8123
MULTIRAG_ADMIN_PORT=8130

# These selectors are intentionally kept outside service_conf.yaml in the
# current application contract. Put database, storage, Redis, vector engine,
# and secret connection details in MULTIRAG_CONFIG_FILE.
STORAGE_IMPL=MINIO
DOC_ENGINE=milvus
DEVICE=cpu

# The image starts its built-in Redis by default. Set this to 0 when
# service_conf.yaml points to an external Redis service.
ENABLE_REDIS=1
