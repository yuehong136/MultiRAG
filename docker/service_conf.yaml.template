# 配置文件用于定义各种服务的连接和认证信息，以确保应用程序能正确地与这些服务通信。
multirag:
  # multirag服务的监听地址
  host: ${MULTIRAG_HOST:-0.0.0.0}
  # multirag服务的HTTP端口
  http_port: ${SVR_HTTP_PORT:-8123}
  # multirag服务的SECRET_KEY
  secret_key: '${MULTIRAG_SECRET_KEY:-multirag}'
  # 管理后台是否需要超级管理员权限 (true: 仅超级管理员, false: 所有激活用户)
  admin_require_superuser: false

multimodal_upload_storage:
  # 指定用于多模态文件上传的存储类型: minio, oss, s3, azure_spn, azure_sas
  type: "minio"
  # 指定存储桶名称，如果不填则使用对应存储类型的默认桶
  bucket: "multimodal-temp"

admin:
  host: ${MULTIRAG_HOST:-0.0.0.0}
  http_port: ${ADMIN_SVR_HTTP_PORT:-8130}

postgresql:
  # 数据库的类型
  name: 'postgresql'
  # 数据库的名称
  dbname: '${POSTGRES_DBNAME:-postgres}'
  # postgresql数据库的用户名
  user: '${POSTGRES_USER:-usr_ai}'
  # postgresql数据库的密码
  password: '${POSTGRES_PASSWORD:-123456}'
  # postgresql数据库的主机名
  host: '${POSTGRES_HOST:-postgres}'
  # postgresql数据库的端口
  port: ${POSTGRES_PORT:-5432}
  # postgresql的最大连接数
  max_connections: 100
  # postgresql的过期超时时间
  stale_timeout: 30

minio:
  # MinIO服务的用户名
  user: '${MINIO_USER:-minioadmin}'
  # MinIO服务的密码
  password: '${MINIO_PASSWORD:-12345678}'
  # MinIO服务的主机名和端口
  host: '${MINIO_HOST:-minio}:9000'
  region: '${MINIO_REGION:-}'
  # 工作流过程中使用的桶名称
  workflow_bucket: '${MINIO_WORKFLOW_BUCKET:-multirag-workflow}'
  bucket: '${MINIO_BUCKET:-}'
  prefix_path: '${MINIO_PREFIX_PATH:-}'

azure:
  auth_type: '${AZURE_AUTH_TYPE:-spn}'
  account_url: '${AZURE_ACCOUNT_URL:-account_url}'
  client_id: '${AZURE_CLIENT_ID:-client_id}'
  secret: '${AZURE_SECRET:-secret}'
  tenant_id: '${AZURE_TENANT_ID:-tenant_id}'
  container_name: '${AZURE_CONTAINER_NAME:-container_name}'
  # SAS 认证方式
  # container_url: '${AZURE_CONTAINER_URL:-container_url}'
  # sas_token: '${AZURE_SAS_TOKEN:-sas_token}'

opendal:
  scheme: '${OPENDAL_SCHEME:-mysql}'  # Storage type, such as s3, oss, azure, etc.
  config:
  oss_table: 'opendal_storage'

s3:
  access_key: '${S3_ACCESS_KEY:-access_key}'
  secret_key: '${S3_SECRET_KEY:-secret_key}'
  region: '${S3_REGION:-region}'
  endpoint_url: '${S3_ENDPOINT_URL:-endpoint_url}'
  bucket: '${S3_BUCKET:-bucket}'
  prefix_path: '${S3_PREFIX_PATH:-prefix_path}'
  signature_version: 'v4'
  addressing_style: 'path'

gcs:
  bucket: '${GCS_BUCKET:bridgtl-edm-d-bucket-multirag'

oss:
  access_key: '${OSS_ACCESS_KEY:-access_key}'
  secret_key: '${OSS_SECRET_KEY:-secret_key}'
  endpoint_url: '${OSS_ENDPOINT:-http://oss-cn-hangzhou.aliyuncs.com}'
  region: '${OSS_REGION:-cn-hangzhou}'
  bucket: '${OSS_BUCKET:-bucket_name}'
  prefix_path: '${OSS_PREFIX_PATH:-prefix_path}'

milvus:
  # Milvus服务的主机地址
  hosts: '${MILVUS_HOSTS:-http://milvus:19530}'
  # Milvus服务的用户名
  username: '${MILVUS_USERNAME:-root}'
  # Milvus服务的密码
  password: '${MILVUS_PASSWORD:-Milvus}'
  db_name: '${MILVUS_DB_NAME:-}'
  token: '${MILVUS_TOKEN:-}'
  timeout: null
  kwargs: {}

vastbase:
  host: '${VASTBASE_HOST:-vastbase}'
  port: ${VASTBASE_PORT:-5434}
  database: '${VASTBASE_DATABASE:-datav}'
  user: '${VASTBASE_USER:-datav}'
  password: '${VASTBASE_PASSWORD:-Datav@12}'
  max_connections: 20
  schema: public

es:
  # Elasticsearch服务的主机地址
  hosts: 'http://${ES_HOST:-es01}:9200'
  # Elasticsearch服务的用户名
  username: '${ES_USER:-elastic}'
  # Elasticsearch服务的密码
  password: '${ELASTIC_PASSWORD:-infini_rag_flow}'

os:
  hosts: 'http://${OS_HOST:-opensearch01}:9201'
  username: '${OS_USER:-admin}'
  password: '${OPENSEARCH_PASSWORD:-infini_rag_flow_OS_01}'

infinity:
  uri: '${INFINITY_HOST:-infinity}:23817'
  db_name: 'default_db'

oceanbase:
  scheme: 'oceanbase' # set 'mysql' to create connection using mysql config
  config:
    db_name: '${OCEANBASE_DOC_DBNAME:-test}'
    user: '${OCEANBASE_USER:-root@multirag}'
    password: '${OCEANBASE_PASSWORD:-dxl_multi_rag}'
    host: '${OCEANBASE_HOST:-oceanbase}'
    port: ${OCEANBASE_PORT:-2881}

redis:
  db: 1
  username: '${REDIS_USERNAME:-}'
  password: '${REDIS_PASSWORD:-}'
  host: '${REDIS_HOST:-redis}:6379'

task_executor:
  message_queue_type: 'redis'

user_default_llm:
  factory: '${LLM_FACTORY:-}'
  api_key: '${LLM_API_KEY:-}'
  base_url: '${LLM_BASE_URL:-}'
  default_models:
    chat_model:
      name: '${CHAT_MODEL_NAME:-}'
      factory: '${CHAT_MODEL_FACTORY:-}'
      api_key: '${CHAT_MODEL_API_KEY:-}'
      base_url: '${CHAT_MODEL_BASE_URL:-}'
    embedding_model:
      api_key: '${EMBEDDING_MODEL_API_KEY:-xxx}'
      base_url: 'http://${TEI_HOST:-tei}:80'
    rerank_model: '${RERANK_MODEL:-BAAI/bge-reranker-v2-m3}'
    asr_model:
      model: '${ASR_MODEL:-whisper-large-v3}'
    image2text_model: '${IMAGE2TEXT_MODEL:-}'

oauth:
  oauth2:
    display_name: "OAuth2"
    client_id: "${OAUTH2_CLIENT_ID:-your_client_id}"
    client_secret: "${OAUTH2_CLIENT_SECRET:-your_client_secret}"
    authorization_url: "${OAUTH2_AUTHORIZATION_URL:-https://your-oauth-provider.com/oauth/authorize}"
    token_url: "${OAUTH2_TOKEN_URL:-https://your-oauth-provider.com/oauth/token}"
    userinfo_url: "${OAUTH2_USERINFO_URL:-https://your-oauth-provider.com/oauth/userinfo}"
    redirect_uri: "${OAUTH2_REDIRECT_URI:-https://your-app.com/v1/user/oauth/callback/oauth2}"
  oidc:
    display_name: "OIDC"
    client_id: "${OIDC_CLIENT_ID:-your_client_id}"
    client_secret: "${OIDC_CLIENT_SECRET:-your_client_secret}"
    issuer: "${OIDC_ISSUER:-https://your-oauth-provider.com/oidc}"
    scope: "openid email profile"
    redirect_uri: "${OIDC_REDIRECT_URI:-https://your-app.com/v1/user/oauth/callback/oidc}"
  github:
    type: "github"
    icon: "github"
    display_name: "Github"
    client_id: "${GITHUB_CLIENT_ID:-your_client_id}"
    client_secret: "${GITHUB_CLIENT_SECRET:-your_client_secret}"
    redirect_uri: "${GITHUB_REDIRECT_URI:-https://your-app.com/v1/user/oauth/callback/github}"

authentication:
  client:
    # 客户端认证开关
    switch: false
    # HTTP应用的密钥
    http_app_key:
    # HTTP应用的密钥
    http_secret_key:
  site:
    # 站点认证开关
    switch: false

permission:
  # 权限检查开关
  switch: false
  # 是否启用组件权限检查
  component: false
  # 是否启用数据集权限检查
  dataset: false

smtp:
  mail_server: "${SMTP_SERVER:-}"
  mail_port: ${SMTP_PORT:-465}
  mail_use_ssl: true
  mail_use_tls: false
  mail_username: "${SMTP_USERNAME:-}"
  mail_password: "${SMTP_PASSWORD:-}"
  mail_default_sender:
    - "MultiRAG"
    - "${SMTP_SENDER_EMAIL:-}"
  mail_frontend_url: "${MAIL_FRONTEND_URL:-https://your-frontend.example.com}"

tcadp_config:
  secret_id: '${TENCENT_SECRET_ID:-tencent_secret_id}'
  secret_key: '${TENCENT_SECRET_KEY:-tencent_secret_key}'
  region: '${TENCENT_REGION:-tencent_region}'

script_scheduler:
  # 如果源码部署，则使用localhost，如果docker部署，则使用宿主机的ip
  host: ${SCRIPT_SCHEDULER_HOST:-localhost}
  port: ${SCRIPT_SCHEDULER_PORT:-8124}

dcs_server:
  # 有些功能需要与中台服务通信
  protocol: ${DCS_PROTOCOL:-http}
  host: ${DCS_HOST:-localhost}
  port: ${DCS_PORT:-8080}
  # 调用语义层接口时，需要使用的认证信息
  semantic_server:
    access_key: ${DCS_ACCESS_KEY:-multirag}
    secret_key: ${DCS_SECRET_KEY:-}
