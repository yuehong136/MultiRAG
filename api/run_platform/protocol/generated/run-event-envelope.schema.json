{
  "$defs": {
    "JsonValue": {}
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The stable identity-free v2 envelope for additive event types.",
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "data": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Data",
      "type": "object"
    },
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "seq": {
      "minimum": 1,
      "title": "Seq",
      "type": "integer"
    },
    "thread_id": {
      "title": "Thread Id",
      "type": "string"
    },
    "turn_id": {
      "title": "Turn Id",
      "type": "string"
    },
    "type": {
      "title": "Type",
      "type": "string"
    },
    "v": {
      "const": 2,
      "title": "V",
      "type": "integer"
    }
  },
  "required": [
    "v",
    "event_id",
    "run_id",
    "thread_id",
    "turn_id",
    "seq",
    "type",
    "created_at",
    "data"
  ],
  "title": "RunEventEnvelope",
  "type": "object"
}
